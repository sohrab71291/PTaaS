generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TESTER
  VIEWER
}

enum AgentStatus {
  online
  offline
  busy
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  passwordHash        String
  name                String
  role                Role      @default(TESTER)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model TestSpec {
  id            String      @id @default(cuid())
  name          String
  description   String?
  tags          String[]
  request       Json
  loadProfile   Json
  thresholds    Json
  checks        String[]
  environmentId   String?
  generatedScript String?
  slos            Json      @default("[]")
  testType        String?
  complexity      String?
  envVars         Json      @default("[]")
  // Source files (test-case CSV/XLSX/YAML/TXT, or HAR/JSON captures) that
  // generatedScript was produced from — persisted so editing the suite later
  // doesn't lose them (they're needed to fully regenerate the script; small
  // edits instead go through the incremental /api/ai-refine sync path).
  // Shape: [{ name, content /* base64 */, mimeType, source: 'ai' | 'har' }]
  uploadedFiles   Json      @default("[]")
  lastRunStatus   String?
  lastRunAt     DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  executions    Execution[]
  schedules     Schedule[]
}

model Execution {
  id                 String    @id @default(cuid())
  specId             String?
  spec               TestSpec? @relation(fields: [specId], references: [id])
  specName           String
  environment        String
  status             String    @default("queued")
  triggeredBy        String
  startedAt          DateTime?
  finishedAt         DateTime?
  scheduledFor       DateTime?
  duration           Int?
  metrics            Json?
  thresholdBreaches  Int       @default(0)
  checksPassed       Int       @default(0)
  checksFailed       Int       @default(0)
  thresholdResults   Json      @default("[]")
  checkResults       Json      @default("[]")
  responseTimeSeries Json      @default("[]")
  slos               Json      @default("[]")
  sloResults         Json      @default("{}")
  agentId            String?
  agent              Agent?    @relation(fields: [agentId], references: [id])
  scheduleId         String?
  schedule           Schedule? @relation(fields: [scheduleId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Environment {
  id               String   @id @default(cuid())
  name             String
  baseUrl          String
  variables        Json     @default("[]")
  secrets          String[]
  requiresApproval Boolean  @default(false)
  executionCount   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Secret {
  id           String    @id @default(cuid())
  name         String
  backend      String
  backendPath  String
  environments String[]
  lastRotated  DateTime  @default(now())
  expiresAt    DateTime?
  status       String    @default("active")
  createdAt    DateTime  @default(now())
}

model Schedule {
  id                   String      @id @default(cuid())
  name                 String
  specId               String
  spec                 TestSpec    @relation(fields: [specId], references: [id])
  environmentId        String?
  cronExpression       String
  enabled              Boolean     @default(true)
  notificationConfigId String?
  lastRunAt            DateTime?
  lastRunStatus        String?
  nextRunAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  executions           Execution[]
}

model ExecutionCredential {
  id          String   @id @default(cuid())
  batchId     String
  executionId String?
  loginUrl    String
  username    String
  password    String
  instanceName String?
  rowIndex    Int
  createdAt   DateTime @default(now())

  @@index([batchId])
  @@index([executionId])
}

model Agent {
  id         String      @id @default(cuid())
  name       String
  apiKey     String      @unique
  status     AgentStatus @default(offline)
  hostname   String?
  lastSeen   DateTime?
  k6Version  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  executions Execution[]
}
