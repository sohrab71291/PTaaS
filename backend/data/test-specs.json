[
  {
    "id": "spec-001",
    "name": "Search_API_Load_Test",
    "description": "Load test for the search API endpoint, simulating typical user search patterns",
    "tags": [
      "search",
      "api",
      "load"
    ],
    "request": {
      "url": "https://api.example.com/search",
      "method": "GET",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Accept",
          "value": "application/json"
        }
      ],
      "payload": null,
      "auth": {
        "type": "bearer",
        "tokenSecret": "api_token"
      }
    },
    "loadProfile": {
      "type": "staged",
      "stages": [
        {
          "duration": "2m",
          "target": 25
        },
        {
          "duration": "5m",
          "target": 100
        },
        {
          "duration": "2m",
          "target": 50
        },
        {
          "duration": "1m",
          "target": 0
        }
      ],
      "thinkTime": 1
    },
    "thresholds": {
      "http_req_duration": [
        {
          "condition": "p(95)<500",
          "abortOnFail": false
        }
      ],
      "http_req_failed": [
        {
          "condition": "rate<0.01",
          "abortOnFail": true
        }
      ]
    },
    "checks": [
      "status is 200",
      "response time < 500ms",
      "response has results field"
    ],
    "environmentId": "env-qa",
    "lastRunStatus": "pass",
    "lastRunAt": "2026-06-01T10:00:00Z",
    "createdAt": "2026-05-01T09:00:00Z",
    "updatedAt": "2026-06-01T09:00:00Z"
  },
