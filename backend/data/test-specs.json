          "duration": "2m",
          "target": 50
        },
        {
          "duration": "4m",
          "target": 200
        },
        {
          "duration": "1m",
          "target": 300
        },
        {
          "duration": "1m",
          "target": 0
        }
      ],
      "thinkTime": 3
    },
    "thresholds": {
      "http_req_duration": [
        {
          "condition": "p(95)<2000",
          "abortOnFail": false
        }
      ],
      "http_req_failed": [
        {
          "condition": "rate<0.01",
          "abortOnFail": true
        }
      ]
    },
    "checks": [
      "status is 200",
      "order created",
      "order has id"
    ],
