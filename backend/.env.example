# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/ptaas"

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET="change-me-minimum-32-character-random-string"
JWT_EXPIRES_IN="7d"

# Anthropic API key (required for AI script generation)
ANTHROPIC_API_KEY="sk-ant-api03-..."

# Grafana (optional — enables dashboard embedding and "Sync to Grafana")
# GRAFANA_URL="http://localhost:3000"
# GRAFANA_DASHBOARD_UID="ptaas-perf"
# GRAFANA_API_KEY="glsa_..."   # Service-account token with Editor role; omit for anonymous/no-auth Grafana

# Coralogix (optional — enables log shipping for API calls and k6 execution events)
# Get your Private Key from: Coralogix > Data Flow > API Keys > "Send Your Data"
# CORALOGIX_API_KEY="your-private-key"
# CORALOGIX_APP_NAME="PTaaS"
# CORALOGIX_ENDPOINT="https://ingress.coralogix.com/logs/v1/singles"   # EU1 default

# Coralogix querying (optional — powers the Observability nav page: Logs + Traces)
# Needs an API key scoped for "Query Logs/DataPrime" (can differ from CORALOGIX_API_KEY above)
# CORALOGIX_QUERY_API_KEY="your-query-scoped-api-key"
# CORALOGIX_DOMAIN="eu2.coralogix.com"   # your team domain, e.g. coralogix.com / cx498.coralogix.com
