            "text": "<!DOCTYPE html>\n<html>\n\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1,shrink-to-fit=no\" />\n  <meta name=\"theme-color\" content=\"#000000\" />\n  <title>Archer IRM</title>\n  <link rel=\"shortcut icon\" href=\"./favicon.ico\" />\n  <style>\n    body {\n      overflow: hidden;\n    }\n\n    #navigationloader>div:not(.notistack-SnackbarContainer) {\n      position: relative;\n      z-index: 1300;\n      /* Make sure the navigation is on top of the content but underneath snackbars */\n    }\n\n    #contentSection {\n      display: flex;\n      width: 100%;\n      overflow: hidden;\n      position: relative;\n      height: calc(100vh - 50px);\n    }\n\n    @media only screen and (max-width: 500px) {\n      #contentSection {\n        height: calc(100vh - 70px);\n      }\n    }\n\n    #sideNavigationloader {\n      height: 100%;\n      z-index: 1200;\n    }\n\n    #sideNavigationloader>div:first-child {\n      margin-right: 0;\n    }\n\n    #content {\n      position: inherit;\n    }\n\n    #content {\n      flex-grow: 1;\n      overflow: auto;\n      overflow: hidden;\n    }\n\n    #drawerButton svg[data-testid='MenuIcon'] {\n      height: 50px;\n      margin-top: -10px;\n    }\n\n    #drawerButton {\n      top: 0.75rem;\n    }\n\n    #root {\n      height: 100%;\n    }\n\n    .hide-nav {\n      display: none;\n    }\n  </style>\n  <script type=\"module\" crossorigin src=\"/ngrx-ui/js/index-8.719.2.js\"></script>\n  <link rel=\"modulepreload\" crossorigin href=\"/ngrx-ui/js/@archer-technologies/ui-components-8.719.2.js\">\n  <link rel=\"modulepreload\" crossorigin href=\"/ngrx-ui/js/@archer-technologies/grid-8.719.2.js\">\n  <link rel=\"stylesheet\" crossorigin href=\"/ngrx-ui/css/@archer-technologies/grid-8.719.2.css\">\n</head>\n\n<body>\n  <div id=\"navigationloader\"></div>\n  <div id=\"contentSection\">\n    <div id=\"sideNavigationloader\"></div>\n    <div id=\"content\">\n      <div id=\"root\"></div>\n    </div>\n  </div>\n  <script>\n    const id = new Date().getTime();\n    const navigation = document.createElement('script');\n    const hash = window.location.hash.substring(1);\n    const hashParams = new URLSearchParams(hash.substring(hash.indexOf('?')));\n\n    const getRedirectRoute = () => {\n      return `/default.aspx?requestUrl=**grcr/${btoa(\n        JSON.stringify({\n          url: `/ngrx-ui/index.html${window.location.hash}`\n        })\n      ).replace('/', '~')}#redirect`;\n    };\n\n    if (hashParams.get('hideNav') === 'true') {\n      document.getElementById('navigationloader').classList.add('hide-nav');\n      document.getElementById('sideNavigationloader').classList.add('hide-nav');\n    }\n    navigation.setAttribute(\n      'src',\n      'false' != 'true'\n        ? '/apps/ArcherApp/navigation/static/js/navigation.js?id=' + id\n        : '/ngrx-ui/navigation/static/js/navigation.js'\n    );\n    navigation.setAttribute('type', 'module');\n    fetch('/apps/ArcherApp/ArcherApp.aspx')\n      .then((response) => {\n        return response\n          .clone()\n          .text()\n          .then((text) => {\n            try {\n              return JSON.parse(text);\n            } catch (error) {\n              window.location.href = getRedirectRoute();\n              return null;\n            }\n          });\n      })\n      .then((globals) => {\n        if (globals) {\n          window.ArcherApp = {\n            ...globals\n          };\n          document.head.appendChild(navigation);\n        }\n      });\n  </script>\n</body>\n\n</html>\n"
