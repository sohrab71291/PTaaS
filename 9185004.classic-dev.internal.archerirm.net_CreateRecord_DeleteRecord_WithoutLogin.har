          \"Key\":\"cmmn:close\",\"Value\":\"Close\"\r\n        },{\r\n          \"Key\":\"cmmn:warning\",\"Value\":\"Warning\"\r\n        },{\r\n          \"Key\":\"cmmn:next\",\"Value\":\"Next\"\r\n        },{\r\n          \"Key\":\"cmmn:previous\",\"Value\":\"Previous\"\r\n        },{\r\n          \"Key\":\"cmmn:error\",\"Value\":\"Error\"\r\n        },{\r\n          \"Key\":\"cmmn:saving\",\"Value\":\"Saving...\"\r\n        },{\r\n          \"Key\":\"cmmn:browse\",\"Value\":\"Browse\"\r\n        },{\r\n          \"Key\":\"cmmn:locale\",\"Value\":\"Locale\"\r\n        },{\r\n          \"Key\":\"cmmn:showLanguageLocalesOnly\",\"Value\":\"Show only locales that are assigned to a language.\"\r\n        },{\r\n          \"Key\":\"cmmn:fileUpload\",\"Value\":\"File Upload\"\r\n        },{\r\n          \"Key\":\"cmmn:fileToUpload\",\"Value\":\"File to upload\"\r\n        },{\r\n          \"Key\":\"cmmn:fileMessageTarget\",\"Value\":\"Upload\"\r\n        },{\r\n          \"Key\":\"cmmn:fileUploadFailed\",\"Value\":\"Error occurred while attempting to upload the file.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:title\",\"Value\":\"Data Import Wizard\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fieldDelimiter\",\"Value\":\"Field Delimiter\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:valueDelimiter\",\"Value\":\"Values Delimiter\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:htmlFormatting\",\"Value\":\"HTML Formatting\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:notifications\",\"Value\":\"Notifications\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:step1\",\"Value\":\"Step 1 - Import File Information\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:step2\",\"Value\":\"Step 2 - Identification\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:step3\",\"Value\":\"Step 3 - Wizard Summary\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:sectionTitleGeneral\",\"Value\":\"General Information\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:infoTextGeneralStep1\",\"Value\":\"Click \\\"Browse\\\" and select the delimited file that contains the external information you want to import into the Archer GRC Platform. Only data contained in delimited files can be imported. A delimited file is a file in which fields are separated by a specific character, such as a comma or tab. Common file extensions for delimited files include .TXT and .CSV.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:notificationsSendDescription\",\"Value\":\"Send a notification for each record that is added or updated, provided the record meets one or more notification criteria.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:doNotSendNotifications\",\"Value\":\"Do Not Send Notifications\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:sendNotifications\",\"Value\":\"Send Notifications\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:singleQuotesExample\",\"Value\":\"Example:  'Volcano','6','Test'\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:doubleQuotesExample\",\"Value\":\"Example:  \\\"Volcano\\\",\\\"6\\\",\\\"Test\\\"\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:none\",\"Value\":\"None\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:singleQuotes\",\"Value\":\"Single Quotes\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:doubleQuotes\",\"Value\":\"Double Quotes\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fieldValueQuotes\",\"Value\":\"Field Value Quotes\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:infoTextAdvOpts\",\"Value\":\"The fields below allow you to specify advanced import options, include determining if your data fields contain field values quotes and if you desire to send a notification for each record created and updated after the import process has completed.  Additionally, if your application contains cross-references, you can determine if reference data is replaced or appended.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:sectionTitleAdvOpts\",\"Value\":\"Advanced Options\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:htmlFormattingDoesNotContainDescription\",\"Value\":\"The file you are importing does not contain HTML.  Only plain text exists within the data file.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:htmlFormattingContainsDescription\",\"Value\":\"The file you are importing contains HTML.  The HTML will be imported along with the data.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:htmlFormattingDoesNotContain\",\"Value\":\"File Does Not Contain HTML Formatting\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:htmlFormattingContains\",\"Value\":\"File Contains HTML Formatting\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:headerRowDoesNotContainDescription\",\"Value\":\"The file you are importing does not contain a header row.  The data to be imported begins on row 1.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:headerRowContainsDescription\",\"Value\":\"The file you are importing contains a Header row, naming each column within the file.  Data to be imported begins on row 2.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:headerRowDoesNotContain\",\"Value\":\"File Does Not Contain Header Row\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:headerRowContains\",\"Value\":\"File Contains Header Row\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:headerRow\",\"Value\":\"Header Row\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:otherEscSeqExample\",\"Value\":\"Example: \\\"c:**inetpub**wwwroot**Archer\\\"\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:backslashExample\",\"Value\":\"Example: \\\"c:\\\\inetpub\\\\wwwroot\\\\Archer\\\"\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:backslash\",\"Value\":\"Backslash\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:escapeSequence\",\"Value\":\"Escape Sequence\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:otherValueExample\",\"Value\":\"Example:  'Sedan','Luxury','Black:Red:Blue:Yellow'\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:pipeExample\",\"Value\":\"Example:  'Sedan','Luxury','Black|White|Red|Blue|Yellow'\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:semicolonExample\",\"Value\":\"Example:  'Sedan','Luxury','Black;White;Red;Blue;Yellow'\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:pipe\",\"Value\":\"Pipe\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:semicolon\",\"Value\":\"Semi-colon\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:otherFieldExample\",\"Value\":\"Example:  'Metro'|'1.6'|'2003'|'Industrial Park'\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:tabExample\",\"Value\":\"Example:  'Metro'     '1.6'     '2003'     'Industrial Park'\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:data_import_progress_message\",\"Value\":\"{0} Rows of {1} succeeded, {2} failed.\"\r\n        },{\r\n          \"Key\":\"cmmn:invalidFileFormat\",\"Value\":\"Invalid file format . Format(s) allowed: \"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:lookupField\",\"Value\":\"Lookup Field(s)\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:mapping\",\"Value\":\"Mapping\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:commaExample\",\"Value\":\"Example:  'Metro','1.6','2003','Industrial Park'\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:other\",\"Value\":\"Other\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:tab\",\"Value\":\"Tab\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:comma\",\"Value\":\"Comma\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:infoTextFormat\",\"Value\":\"Choose the options below that best fit your import file. You can specify field delimiters (characters that separate your fields), specify value delimiters (characters that separate multiple values in a single field) and indicate whether HTML formatting is present within the external file.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:summary\",\"Value\":\"Summary\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:uploadFileSizeExceed\",\"Value\":\"Your file {0}\\u00a0could not be uploaded because it is too big.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:valuesList\",\"Value\":\"Values List\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:addUnknown\",\"Value\":\"Add unknown values\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:ignoreUnknown\",\"Value\":\"Ignore unknown values\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:addUnknownDescription\",\"Value\":\"Adds new values to the values list\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:ignoreUnknownDescription\",\"Value\":\"Blocks new values from being added. Non-matching values in the import file will result in blank or no selection in the record\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:sectionTitleFormat\",\"Value\":\"Format Options\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fileEncoding\",\"Value\":\"File Encoding\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:importFile\",\"Value\":\"Import File\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:castMapping\",\"Value\":\"In order to import into a Cross Module Status Tracking field you must map both the related key field and the Status field.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:requiredFieldNotMapped\",\"Value\":\"is a required field and is not mapped.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:multiFieldMapError\",\"Value\":\"Multiple columns are mapped to the same field.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:noMappings\",\"Value\":\"No fields have been mapped.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fieldNotMapped\",\"Value\":\"{0} is selected as a Key Field but is not mapped.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:noSubformsSelected\",\"Value\":\"No Sub-Form Key Fields are selected.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:noApplicationsSelected\",\"Value\":\" No Application Key Fields are selected.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:dataRow\",\"Value\":\"Data Row\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fieldType\",\"Value\":\"Field Type\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:applicationFields\",\"Value\":\"Application Fields\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:noRecordsFound\",\"Value\":\"No records were found in the selected file\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:doNotImport\",\"Value\":\"Do Not Import\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:colonStatus\",\"Value\":\": Status\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:otherText\",\"Value\":\": Other Text\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:infoTextFieldMapping\",\"Value\":\"Map the columns from the import file to the correct fields within the Archer application, questionnaire or sub-form. Select the \\\"Do Not Import\\\" option for any column from the source file that you do not want to import. Any Archer field(s) specified as a unique identifier must be mapped to a column within the source file.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:sectionTitleFieldMapping\",\"Value\":\"Import Field Mapping\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:subformFields\",\"Value\":\"Sub-Form Field(s)\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:applicationField\",\"Value\":\"Application Field(s)\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:importType\",\"Value\":\"Import Type\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:infoTextGeneralStep2\",\"Value\":\"The Data Import Manager can perform the following import types: \\\"Create New Records\\\" or \\\"Update Existing Records\\\". If you select the \\\"Update Existing Records\\\" option, you must specify one or more fields from the Archer application, questionnaire or sub-form that should be used as a unique identifier for the data import. When a match cannot be found between the source file and an existing Archer record, the system creates a new record when you select the \\\"Update Existing Records\\\" option.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:specifyOtherDelimiter\",\"Value\":\"Please specify the delimiter.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fileNotSpecified\",\"Value\":\"Import file must be specified.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:appendCrossRefDataDescription\",\"Value\":\"Append the references that are contained in the data file to the existing references contained in each record.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:replaceCrossRefDataDescription\",\"Value\":\"Replace all existing references with only the references contained in the data file.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:appendCrossRefData\",\"Value\":\"Append to Existing Cross-Reference Data\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:replaceCrossRefData\",\"Value\":\"Replace Existing Cross-Reference Data\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:crossRefBehavior\",\"Value\":\"Cross-Reference Behavior\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:notificationsDoNotSendDescription\",\"Value\":\"Ignore the notification process for records added or updated. The data import process disregards notification criteria.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:wizardSummary\",\"Value\":\"Wizard Summary\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:option\",\"Value\":\"Option\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:selection\",\"Value\":\"Selection\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:columnMappings\",\"Value\":\"Column Mappings\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:importColumnName\",\"Value\":\"Import Column Name\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fieldName\",\"Value\":\"Field Name\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fileName\",\"Value\":\"File Name\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fieldNamesHeader\",\"Value\":\"Field Names (Header)\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:quotedFieldValues\",\"Value\":\"Quoted Field Values\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:importMethod\",\"Value\":\"Import Method\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:importTypeLabel\",\"Value\":\"Import Type\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:importError\",\"Value\":\"Import Error\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:import\",\"Value\":\"Import\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:subformRecords\",\"Value\":\"Sub-Form Records\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:applicationRecord\",\"Value\":\"Application Record\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:levelRecord\",\"Value\":\"Level Record\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:questionnaireRecord\",\"Value\":\"Questionnaire  Record\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:default\",\"Value\":\"Default\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:usASCII\",\"Value\":\"US-ASCII\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:utf8\",\"Value\":\"UTF8\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:utf7\",\"Value\":\"UTF7\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:utf32\",\"Value\":\"UTF32\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:unicode\",\"Value\":\"Unicode\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:createNewRecords\",\"Value\":\"Create New Records\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:updateExistingRecords\",\"Value\":\"Update Existing Records\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:cancelJob\",\"Value\":\"Cancel Job\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:detail\",\"Value\":\"Detail\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:importing\",\"Value\":\"Importing\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:validating\",\"Value\":\"Validating\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:data_import_async_warning\",\"Value\":\"Your data import has been queued for processing in the Job Engine Service. You can choose to wait for your import to be processed or you can review the results of the import later in the \\\"Review Job Queues\\\" page in the Integration section of Administration. You can also cancel the job by clicking the \\\"Cancel Job\\\" button below.\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:customDelimiter\",\"Value\":\"Custom delimiter\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:step1ImportFile\",\"Value\":\"Step 1 - Import File\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:step2Mapping\",\"Value\":\"Step 2 - Mapping\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:fieldNames\",\"Value\":\"Field Names\"\r\n        },{\r\n          \"Key\":\"dtmprtwzrd:header\",\"Value\":\"Header\"\r\n        }\r\n      ]\r\n    },{\r\n      \"id\":\"RecordPage\",\"resources\":[\r\n        {\r\n          \"Key\":\"ValidationMessageTemplates:InvalidFile\",\"Value\":\"The imported file type is not .xlsx or .xls. Verify the file type and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"cmmn:sheet\",\"Value\":\"Sheet\"\r\n        },{\r\n          \"Key\":\"cmmn:valid\",\"Value\":\"Valid\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:ExportImportFieldRequired\",\"Value\":\"A required field in the Excel file does not include a value. Enter the required value and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:LevelIdWithColumnMismatch\",\"Value\":\"The parent record\\u2019s ID in the Excel file does not match the related ID field in Archer. Correct the ID value in the exported file and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:GlossarySheetDataMismatch\",\"Value\":\"The Field Glossary worksheet contains invalid values. Export the file again, add the exported Field Glossary worksheet and upload the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:DuplicateColumnName\",\"Value\":\"The Excel file includes a duplicate field. Remove the duplicate field and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:ColumnNameMismatch\",\"Value\":\"The first row in the Excel file contains a field that is not found in the Field Glossary. Correct the field in the first row and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:SheetNameMismatch\",\"Value\":\"The worksheet name in the Excel file does not match the corresponding application name in Archer. Correct the worksheet name and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:GlossarySheetMissing\",\"Value\":\"The Field Glossary worksheet in the Excel file cannot be found. Correct or add the Field Glossary worksheet name and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:PasswordProtectedCheck\",\"Value\":\"The selected file has one or more password protected sheets. Remove the password protection from all sheets and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"recpage:exportToExcel\",\"Value\":\"Export to Excel\"\r\n        },{\r\n          \"Key\":\"recpage:unableToExport\",\"Value\":\"Unable to Export\"\r\n        },{\r\n          \"Key\":\"recpage:excelExportSelectHelpText\",\"Value\":\"To generate the Excel workbook, select the fields you would like to be exported. You can select fields from the target application as well as from any related applications. Any data from cross-referenced applications will be exported to additional sheets within the Excel workbook. Data from the target record will show in the first sheet, while any cross-referenced record will show as rows within their respective sheet.\"\r\n        },{\r\n          \"Key\":\"recpage:emailAddressRequired\",\"Value\":\"Cannot export the workbook. Go to your profile or contact your system administrator to update your email address first.\"\r\n        },{\r\n          \"Key\":\"recpage:excelExportSuccess\",\"Value\":\"Archer will send the link to download the exported Excel file to your email.\"\r\n        },{\r\n          \"Key\":\"recpage:excelExportSelect\",\"Value\":\"Select Export Data\"\r\n        },{\r\n          \"Key\":\"recpage:excelExportFieldValidate\",\"Value\":\"Select at least one field from parent record.\"\r\n        },{\r\n          \"Key\":\"recpage:recordPageViewEdit\",\"Value\":\"Record Page (View, Edit)\"\r\n        },{\r\n          \"Key\":\"recpage:recordPageAddNew\",\"Value\":\"Record Page (Add New)\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:SingleRowInParentSheet\",\"Value\":\"There is more than one Target Parent Module record in the Excel file. Remove the other records and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:ExportImportContainKeyFieldValueAsApplicationTrackingId\",\"Value\":\"The {0} field is an application key field in Archer. Change the field to a system tracking ID field and then import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:ExportImportContainInvalidKeyFieldValue\",\"Value\":\"The {0} value does not match a related record key field value in Archer. Correct the value in the exported file and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:ExportImportNotContainSystemTrackingId\",\"Value\":\"No unique ID field was found in {0}. Add a unique ID field to the export file and try again\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:ValueNotFound\",\"Value\":\"One or more values in this field do not match the values available in Archer. Correct the values and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"ValidationMessageTemplates:ExportImportTypeCheck\",\"Value\":\"The value of the {0} field is formatted incorrectly. Correct the value and import the corrected file.\"\r\n        },{\r\n          \"Key\":\"recpage:excelImportHelp\",\"Value\":\"Complete these steps to import Excel files into Archer.\"\r\n        },{\r\n          \"Key\":\"recpage:importStatusMessage\",\"Value\":\"Your import is processing. Archer will send you an email that indicates the import status.\"\r\n        },{\r\n          \"Key\":\"recpage:reviewMessage\",\"Value\":\"Review and fix the errors then validate the file again to import the file into Archer.\"\r\n        },{\r\n          \"Key\":\"recpage:totalRows\",\"Value\":\"Total Rows\"\r\n        },{\r\n          \"Key\":\"recpage:runDetails\",\"Value\":\"Run Details\"\r\n        },{\r\n          \"Key\":\"recpage:validationError\",\"Value\":\"Validation error\"\r\n        },{\r\n          \"Key\":\"recpage:excelImportHelpStepFive\",\"Value\":\"5. After Archer successfully validates the file, click Import. Archer sends you an email with the import status. During the import process, Archer validates your record permissions, the record details, and the values lists in the file.\"\r\n        },{\r\n          \"Key\":\"recpage:excelImportHelpStepFour\",\"Value\":\"4. Upload then validate the file again.\"\r\n        },{\r\n          \"Key\":\"recpage:excelImportHelpStepThree\",\"Value\":\"3. Review and correct file errors as needed.\"\r\n        },{\r\n          \"Key\":\"recpage:excelImportHelpStepTwo\",\"Value\":\"2. Click Validate. Archer validates the file structure, file type, and application/record/field IDs of the file data.\"\r\n        },{\r\n          \"Key\":\"recpage:excelImportHelpStepOne\",\"Value\":\"1. In the Import section, upload the exported Excel file.\"\r\n        },{\r\n          \"Key\":\"recpage:importExportFromExcel\",\"Value\":\"Excel Export/Import\"\r\n        },{\r\n          \"Key\":\"recpage:excelExportSuccessMessage\",\"Value\":\"We'll send you an email when your export is ready for download. Click Download in the History section for the exported Excel file.\"\r\n        },{\r\n          \"Key\":\"recpage:archerHelpSystem\",\"Value\":\"Archer help system.\"\r\n