          "content": {
            "size": 1694,
            "mimeType": "application/javascript",
            "text": "(function() {\r\n  // Create and append the SDK script\r\n  const sdkScript = document.createElement('script');\r\n  sdkScript.src = 'https://cdn.rum-ingress-coralogix.com/coralogix/browser/2.10.0/coralogix-browser-sdk.js';\r\n  document.head.appendChild(sdkScript);\r\n\r\n  // Create and append the initialization script\r\n  sdkScript.onload = function() {\r\n      CoralogixRum.init({\r\n        public_key: 'cxtp_LWn2JxWvAdezPgJQXBRuTd4sX99sat',\r\n        application: 'us-west-2-classic-dev-archer-web-ui',\r\n        version: '1.0',\r\n        coralogixDomain: 'US2',\r\n        environment: 'us-west-2-classic-dev',\r\n        sessionRecordingConfig: {\r\n          enable: false,\r\n          autoStartSessionRecording: false\r\n        },\r\n        sessionConfig: {\r\n          sessionSampleRate: 100,\r\n        },\r\n        sessionRecordingConfig:{\r\n          sampling: {\r\n            mousemove: false,\r\n            mouseInteraction: false,\r\n          }\r\n        },\r\n        instrumentations: {\r\n          interactions: false\r\n        },\r\n        ignoreUrls: [/\\/ngrx(?:[?\\\\/].*)?[?&]filter(?:[=&]|$)/i]\r\n      });\r\n\r\n      const checkCoralogix = setInterval(() => {\r\n      if (window.ArcherApp && window.ArcherApp.globals && window.ArcherApp.globals.userId) {\r\n        clearInterval(checkCoralogix);\r\n        CoralogixRum.setUserContext({\r\n          user_id: window.location.hostname + '_' + window.ArcherApp.globals.userId,\r\n          user_metadata: {\r\n            ngrx_flag: window.ArcherApp.globals.ngrxFlag,\r\n            experience_state: window.localStorage.getItem('experienceState') || window.sessionStorage.getItem('experienceState') || 'unknown'\r\n          }\r\n         });\r\n      }\r\n    }, 100);\r\n  };\r\n})();\r\n"
          },
